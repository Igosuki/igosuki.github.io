---
import '@fontsource/familjen-grotesk/latin-400.css';
import '@fontsource/familjen-grotesk/latin-500.css';
import '@fontsource/familjen-grotesk/latin-700.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageIs1200x630?: boolean;
  profile?: boolean;
  article?: { published: Date; modified?: Date; tags: string[] };
}

const { title, description = SITE.description, image, imageIs1200x630 = !image, article, profile } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const imageUrl = new URL(image ?? SITE.ogImage, import.meta.env.DEV ? Astro.url : Astro.site).href;
const imageAlt = title ?? SITE.name;
const person = {
  '@type': 'Person',
  name: SITE.name,
  url: new URL('/about/', Astro.site).href,
  jobTitle: 'Former CTO',
  description: SITE.role,
  image: new URL(SITE.photo, Astro.site).href,
  knowsAbout: ['AI agents', 'Distributed systems', 'Software engineering', 'Startups'],
  sameAs: SITE.links.map((l) => l.href),
};
const blogPosting = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.published.toISOString(),
  dateModified: (article.modified ?? article.published).toISOString(),
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  image: imageUrl,
  keywords: article.tags.join(', '),
  inLanguage: 'en',
  author: person,
  publisher: person,
};
const breadcrumbs = article && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: canonical.href },
  ],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: new URL('/', Astro.site).href,
  description: SITE.description,
  author: person,
};
const profilePage = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  name: SITE.name,
  mainEntity: person,
};
const jsonLd = [article ? blogPosting : profile ? profilePage : website, breadcrumbs].filter(Boolean);
const nav = [
  { href: '/#ideas', label: 'Ideas' },
  { href: '/#notes', label: 'Notes' },
  { href: '/about/', label: 'About' },
];
const github = SITE.links.find((l) => l.label === 'GitHub');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      imageIs1200x630 && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    {
      import.meta.env.PROD && SITE.goatcounter && (
        <script is:inline async data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="frame site-header">
      <a class="wordmark" href="/">{SITE.name}</a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        {
          github && (
            <a class="gh" href={github.href} rel="me">
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
                <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
              </svg>
              GitHub
            </a>
          )
        }
      </nav>
    </header>
    <main id="main" class="frame">
      <slot />
    </main>
    <footer class="frame site-footer">
      <div class="col">
        <p>
          Have an idea, a workshop, a customer list, or funding? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
        <p class="links">
          {SITE.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.4rem 0.7rem;
    background: var(--surface);
    z-index: 10;
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.6rem;
    padding-bottom: 3.5rem;
    font-family: var(--font-display);
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 1rem;
  }
  nav a {
    color: var(--graphite);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .gh svg {
    width: 1em;
    height: 1em;
  }
  .site-footer {
    margin-top: 6rem;
    padding-bottom: 3rem;
    font-size: 1rem;
    color: var(--graphite);
  }
  .site-footer .col {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--font-display);
  }
</style>
