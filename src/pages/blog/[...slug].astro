---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Invite from '../../components/Invite.astro';
import Newsletter from '../../components/Newsletter.astro';
import { STATUS_LABEL } from '../../config';
import { formatDate, getPosts, postPath, type Post } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: postPath(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, kind, status, draft, wip, tags, invite, image } = post.data;
---

<Base title={title} description={description} image={image}>
  <article>
    <header class="head">
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {status && <span class={`status status--${status}`}>{STATUS_LABEL[status]}</span>}
        {draft && <span class="status">Draft, not published</span>}
      </p>
      <div class="col">
        <h1>{title}</h1>
        <p class="description">{description}</p>
        {tags.length > 0 && (
          <ul class="tags" role="list">
            {tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        )}
      </div>
    </header>
    <div class="col prose">
      {wip && !draft && (
        <p class="wip" role="note">
          Work in progress. I'm still writing this post, so parts are missing and may change.
        </p>
      )}
      <Content />
      {updatedDate && <p class="updated">Updated {formatDate(updatedDate)}.</p>}
      {(kind === 'idea' || invite) && <Invite title={title} kind={kind} {...invite} />}
      <Newsletter />
    </div>
  </article>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--graphite);
    margin: 0 0 1rem;
  }
  .description {
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--graphite);
    margin-bottom: 1rem;
  }
  .tags {
    margin-bottom: 3rem;
  }
  h1 {
    text-wrap: balance;
  }
  .wip {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--graphite);
    background: var(--surface);
    border-left: 3px solid var(--rule);
    padding: 0.6rem 0.9rem;
    margin: 0 0 2rem;
  }
  .updated {
    color: var(--graphite);
    font-style: italic;
  }
  .prose :global(h2) {
    margin-top: 2.4em;
  }
  .prose :global(img),
  .prose :global(video) {
    border-radius: 6px;
  }
  .prose :global(figure figcaption) {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--graphite);
    margin-top: 0.5rem;
  }
  @media (min-width: 52rem) {
    .head {
      display: grid;
      grid-template-columns: var(--gutter) minmax(0, var(--measure));
    }
    .meta {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.6rem;
      padding-right: 1.5rem;
    }
    .head .col {
      margin-left: 0;
    }
  }
</style>
