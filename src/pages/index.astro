---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib';

const posts = await getPosts();
const ideas = posts.filter((p) => p.data.kind === 'idea');
const notes = posts.filter((p) => p.data.kind === 'note');
---

<Base>
  <section class="hero col">
    <h1>Software, agents, and the odd startup idea.</h1>
    <p class="lede">
      I'm Guillaume. I've built and scaled products in startups for the past 15 years. I write about software I find
      interesting, how I work with coding agents, and now and then a startup idea I've prototyped. If one of those is
      yours to build, fund or sell, let's talk.
    </p>
  </section>

  <section class="block" aria-labelledby="notes">
    <h2 id="notes" class="col">Notes</h2>
    <PostList posts={notes} empty="Nothing here yet." />
  </section>

  <section class="block" aria-labelledby="ideas">
    <h2 id="ideas" class="col">Ideas</h2>
    <PostList posts={ideas} empty="The first idea is on the workbench." />
  </section>
</Base>

<style>
  .hero h1 {
    font-size: clamp(2.5rem, 7.2vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .lede {
    font-size: 1.3rem;
    line-height: 1.55;
    max-width: 33rem;
  }
  .block {
    margin-top: 5rem;
  }
  .block h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: var(--graphite);
    letter-spacing: 0;
    font-weight: 500;
  }
  @media (min-width: 52rem) {
    .hero h1 {
      margin-left: -0.05em;
      /* Wider than the column, but stops short of the viewport's right edge. */
      width: max(100%, min(54rem, 50vw + 10rem));
    }
  }
</style>
