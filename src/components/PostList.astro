---
import { STATUS_LABEL } from '../config';
import { formatDate, postUrl, type Post } from '../lib';

interface Props {
  posts: Post[];
  empty: string;
}
const { posts, empty } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty col">{empty}</p>
  ) : (
    <ol class="list" role="list">
      {posts.map((post) => (
        <li class="row">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <div class="body">
            <h3>
              <a href={postUrl(post)}>{post.data.title}</a>
              {post.data.draft && <span class="draft">draft</span>}
            </h3>
            <p>{post.data.description}</p>
            {post.data.wip && !post.data.draft && <span class="status wip">Work in progress</span>}
            {post.data.status && (
              <span class={`status status--${post.data.status}`}>{STATUS_LABEL[post.data.status]}</span>
            )}
            {post.data.tags.length > 0 && (
              <ul class="tags" role="list">
                {post.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 1.4rem 0;
  }
  .row + .row {
    border-top: 1px solid var(--rule);
  }
  time {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--graphite);
    margin-bottom: 0.25rem;
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--cobalt);
    text-decoration: underline;
  }
  .body p {
    margin: 0 0 0.5rem;
    color: var(--graphite);
  }
  .draft {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--graphite);
    border: 1px dashed var(--graphite);
    border-radius: 3px;
    padding: 0 0.35em;
    margin-left: 0.5em;
    vertical-align: 0.2em;
  }
  .wip {
    display: inline-block;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0 0.45em;
    margin: 0 0.5rem 0.4rem 0;
  }
  .empty {
    color: var(--graphite);
    font-style: italic;
  }
  @media (min-width: 52rem) {
    .row {
      display: grid;
      grid-template-columns: var(--gutter) minmax(0, var(--measure));
    }
    time {
      padding-top: 0.3rem;
      padding-right: 1.5rem;
      margin: 0;
    }
  }
</style>
