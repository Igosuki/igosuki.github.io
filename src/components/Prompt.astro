---
// A prompt readers can copy into their own agent. Write the prompt as the component's children;
// put placeholders in [square brackets].
interface Props {
  label?: string;
}
const { label = 'Prompt' } = Astro.props;
---

<copy-prompt class="prompt">
  <div class="bar">
    <span class="label">{label}</span>
    <button type="button" class="copy" hidden>Copy</button>
  </div>
  <div class="body"><slot /></div>
</copy-prompt>

<script>
  class CopyPrompt extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('.copy');
      const body = this.querySelector<HTMLElement>('.body');
      if (!button || !body || !navigator.clipboard) return;
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(body.innerText.trim());
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select and copy';
        }
        setTimeout(() => (button.textContent = 'Copy'), 2000);
      });
    }
  }
  customElements.define('copy-prompt', CopyPrompt);
</script>

<style>
  .prompt {
    display: block;
    margin: 0 0 1.4em;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 0.8rem 0.45rem 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }
  .label {
    color: var(--graphite);
  }
  .copy {
    font: inherit;
    color: var(--cobalt);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--cobalt);
  }
  .body {
    padding: 0.9rem 1.1rem 0.2rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .body :global(p) {
    margin: 0 0 0.8em;
  }
</style>
